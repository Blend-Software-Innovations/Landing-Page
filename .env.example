# Environment templates (do not commit real secrets)

# Shared
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# Auth
AUTH_JWT_SECRET=change_me
AUTH_REFRESH_SECRET=change_me

# Admin seed
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=change_me

# Database (required in any real deployment; remove DISABLE_DB to enable the DB)
DATABASE_URL=postgresql://user:pass@localhost:5432/pen_landing
# Managed Postgres CA cert (PEM) for TLS verification. On DO App Platform bind to ${db.CA_CERT}.
# Leave empty for local Postgres (no SSL).
DATABASE_CA_CERT=
# Set to "true" ONLY if the DB has no CA cert (e.g. DO dev database) and is reachable solely
# over a trusted private network: keeps TLS but skips cert verification. Use a managed DB + CA in prod.
DATABASE_SSL_NO_VERIFY=
# DISABLE_DB=1
# Redis — optional; only needed for cross-instance rate limiting when scaling to 2+ instances
REDIS_URL=

# Uploads — DigitalOcean Spaces / any S3-compatible store (preferred in production)
S3_BUCKET=
S3_REGION=blr1
S3_ENDPOINT=https://blr1.digitaloceanspaces.com
S3_PUBLIC_URL=https://your-bucket.blr1.cdn.digitaloceanspaces.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=1
# Uploads — Cloudinary (alternative to S3; takes priority if set)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Site config row id (defaults internally if unset)
CONFIG_ID=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio
TWILIO_SID=
TWILIO_AUTH=
TWILIO_PHONE=

# Meta CAPI
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# Couriers (Bangladesh)
STEADFAST_API_KEY=
STEADFAST_BASE_URL=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_BASE_URL=
REDX_API_KEY=
REDX_BASE_URL=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Cross-origin (optional)
AUTH_COOKIE_DOMAIN=
AUTH_ALLOWLIST_ORIGINS=

# Rate limits
AUTH_RATE_LIMIT_PER_MIN=20
ADMIN_RATE_LIMIT_PER_MIN=60
PUBLIC_RATE_LIMIT_PER_MIN=120

# OTP
OTP_LENGTH=6
OTP_TTL_MIN=5
OTP_SESSION_TTL_MIN=30
OTP_RESEND_COOLDOWN_SEC=60
OTP_LOCKOUT_MAX_ATTEMPTS=5
OTP_LOCKOUT_MIN=10

# --- Abuse controls (added by security hardening) ---
# Number of trusted proxy hops in front of the app, counted from the right of
# X-Forwarded-For. DigitalOcean App Platform behind Cloudflare = 2.
TRUSTED_PROXY_HOPS=2
# Global daily cap on OTP SMS sends (hard brake on SMS-pumping fraud).
OTP_DAILY_MAX=500
