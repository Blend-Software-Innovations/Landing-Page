generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELED
  RETURNED
}

enum PaymentMethod {
  STRIPE
  COD
  BKASH
  NAGAD
  ROCKET
  MANUAL
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
}

enum ManualPaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(OWNER)
  createdAt    DateTime @default(now())
}

model RefreshToken {
  id        String   @id
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model OtpCode {
  id        String   @id
  phone     String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model OtpSession {
  token     String   @id
  phone     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model OtpThrottle {
  phone         String    @id
  cooldownUntil DateTime?
  lockedUntil   DateTime?
  updatedAt     DateTime  @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  type        ProductType @default(PHYSICAL)
  category    String
  brand       String
  sku         String?     @unique
  barcode     String?
  basePrice   Int
  description String
  active      Boolean     @default(true)
  variants    Variant[]
  createdAt   DateTime    @default(now())
}

model Variant {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  name      String
  size      String?
  color     String?
  option    String?
  price     Int
  stockQty Int
  weight    Int?
  sku       String?  @unique
  imageUrl  String?
  createdAt DateTime @default(now())
  inventoryHolds InventoryHold[]
  batches   Batch[]

  @@index([productId])
  @@index([sku])
}

model Batch {
  id           String    @id @default(cuid())
  variant      Variant   @relation(fields: [variantId], references: [id])
  variantId    String
  batchNo      String
  expiryDate   DateTime?
  quantity     Int
  receivedDate DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@unique([variantId, batchNo])
  @@index([variantId, expiryDate])
}

model LandingPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  config      Json
  createdAt   DateTime @default(now())
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String
  config      Json
  createdAt   DateTime @default(now())
}

model Order {
  id              String        @id @default(cuid())
  status          OrderStatus   @default(PENDING)
  customerName    String
  phone           String
  address         String
  city            String
  area            String?
  deliveryArea    String?
  deliverySlot    String?
  total           Int
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(UNPAID)
  manualStatus    ManualPaymentStatus?
  manualProofUrl  String?
  manualSubmittedAt DateTime?
  manualReviewedAt DateTime?
  manualReviewNote String?
  transactionId   String?
  idempotencyKey  String?       @unique
  reservationId   String?       @unique
  reservation     InventoryHold? @relation(fields: [reservationId], references: [id])
  reservationIds  Json?
  shippingPartner String?
  trackingCode    String?
  paymentProvider String?
  paymentLink     String?
  paidAmount      Int?
  deviceFingerprint String?
  fraudFlags      Json?
  fraudScore      Int           @default(0)
  callStatus      String?
  callNotes       String?
  callVerifiedAt  DateTime?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  items           OrderItem[]
  confirmedAt     DateTime?
  packedAt        DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  canceledAt      DateTime?
  returnedAt      DateTime?
  createdAt       DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  productId String
  variantId String?
  quantity  Int
  unitPrice Int
  lineTotal Int

  @@index([orderId])
  @@index([productId])
}

model InventoryHold {
  id        String   @id @default(cuid())
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id])
  quantity  Int
  expiresAt DateTime
  batchAllocations Json?
  order     Order?

  @@index([variantId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String?
  role      String?
  action    String
  data      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// These three tables are accessed through raw SQL (lib/siteConfig.server.ts,
// lib/audit.ts, lib/analytics.ts) rather than the Prisma client, but they MUST
// stay declared here. When they were absent, `prisma migrate dev` treated them
// as drift and generated a DROP (see 20260305193050_init), which silently
// destroyed the live site config until it was restored by hand.
model SiteConfigRow {
  id        String   @id
  data      Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("site_config")
}

model SiteConfigAudit {
  id        String   @id
  configId  String   @map("config_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  actor     String?
  role      String?
  ip        String?
  note      String?
  data      Json

  @@index([configId], map: "site_config_audit_config_id_idx")
  @@index([createdAt], map: "site_config_audit_created_at_idx")
  @@map("site_config_audit")
}

model AnalyticsEventRow {
  id        String   @id
  eventName String   @map("event_name")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  ip        String?
  userAgent String?  @map("user_agent")
  referrer  String?

  @@index([createdAt], map: "analytics_events_created_at_idx")
  @@index([eventName], map: "analytics_events_event_name_idx")
  @@map("analytics_events")
}

model AbandonedCheckout {
  id            String   @id @default(cuid())
  name          String?
  email         String?
  phone         String?
  total         Int?
  items         Json?
  utm           Json?
  status        String   @default("PENDING")
  notifyCount   Int      @default(0)
  lastNotifiedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phone])
  @@index([status])
  @@index([createdAt])
}



